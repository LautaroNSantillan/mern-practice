# Node
**/node_modules/
node_modules/

# Package manager lockfiles (remove if you track lockfiles)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
logs/
*.log

# Build / output
dist/
build/
out/
.vite/

# Frontend (Vite)
front/dist/
front/.vite/

# Backend
back/node_modules/
back/config.env

# Environment files (secrets)
.env
.env.*
.env.local
*.local
config.env

# Coverage
coverage/
nyc_output/

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Misc
*.tgz
.cache/
.tmp/

# Optional: ignore build artifacts from editors/IDEs
*.class
*.pyc
__pycache__/

# Keep this file tracked
!.gitignore
